{
  "$schema": "vscode://schemas/color-theme",
  "name": "FreeLLMAPI Kilo High-Visibility",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#38BDF8",
    "foreground": "#F1F5F9",
    "descriptionForeground": "#CBD5E1",
    "errorForeground": "#FB7185",
    "widget.shadow": "#020617CC",
    "selection.background": "#0284C766",
    "icon.foreground": "#E2E8F0",
    "activityBar.background": "#070B14",
    "activityBar.foreground": "#F8FAFC",
    "activityBar.inactiveForeground": "#94A3B8",
    "activityBar.border": "#1E293B",
    "activityBar.activeBorder": "#38BDF8",
    "activityBarBadge.background": "#F59E0B",
    "activityBarBadge.foreground": "#090D16",
    "sideBar.background": "#0B111E",
    "sideBar.foreground": "#E2E8F0",
    "sideBar.border": "#1E293B",
    "sideBarTitle.foreground": "#F8FAFC",
    "sideBarSectionHeader.background": "#111827",
    "sideBarSectionHeader.foreground": "#F8FAFC",
    "sideBarSectionHeader.border": "#1E293B",
    "list.activeSelectionBackground": "#0EA5E92E",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.hoverBackground": "#1E293B80",
    "list.inactiveSelectionBackground": "#1E293B99",
    "editorGroupHeader.tabsBackground": "#070B14",
    "editorGroupHeader.tabsBorder": "#1E293B",
    "tab.activeBackground": "#090D16",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#38BDF8",
    "tab.inactiveBackground": "#070B14",
    "tab.inactiveForeground": "#94A3B8",
    "tab.border": "#1E293B",
    "editor.background": "#090D16",
    "editor.foreground": "#F1F5F9",
    "editorLineNumber.foreground": "#64748B",
    "editorLineNumber.activeForeground": "#38BDF8",
    "editorCursor.foreground": "#F59E0B",
    "editorCursor.background": "#090D16",
    "editor.selectionBackground": "#0284C755",
    "editor.inactiveSelectionBackground": "#1E293B88",
    "editor.selectionHighlightBackground": "#38BDF826",
    "editor.wordHighlightBackground": "#38BDF82B",
    "editor.wordHighlightStrongBackground": "#F59E0B33",
    "editor.findMatchBackground": "#F59E0B55",
    "editor.findMatchHighlightBackground": "#F59E0B2B",
    "editor.lineHighlightBackground": "#111A2E99",
    "editor.lineHighlightBorder": "#1E293B80",
    "editorGhostText.foreground": "#7DD3FCAA",
    "editorGhostText.border": "#38BDF830",
    "editorSuggestWidget.background": "#0F172A",
    "editorSuggestWidget.border": "#334155",
    "editorSuggestWidget.foreground": "#F1F5F9",
    "editorSuggestWidget.highlightForeground": "#38BDF8",
    "editorSuggestWidget.selectedBackground": "#0284C744",
    "editorHoverWidget.background": "#0F172A",
    "editorHoverWidget.border": "#334155",
    "editorBracketHighlight.foreground1": "#38BDF8",
    "editorBracketHighlight.foreground2": "#F59E0B",
    "editorBracketHighlight.foreground3": "#34D399",
    "editorBracketHighlight.foreground4": "#F472B6",
    "editorBracketMatch.background": "#38BDF826",
    "editorBracketMatch.border": "#38BDF8",
    "diffEditor.insertedTextBackground": "#10B98128",
    "diffEditor.insertedLineBackground": "#10B9811A",
    "diffEditor.removedTextBackground": "#F43F5E2E",
    "diffEditor.removedLineBackground": "#F43F5E1A",
    "editorError.foreground": "#FB7185",
    "editorWarning.foreground": "#FBBF24",
    "editorInfo.foreground": "#38BDF8",
    "editorGutter.addedBackground": "#10B981",
    "editorGutter.modifiedBackground": "#38BDF8",
    "editorGutter.deletedBackground": "#F43F5E",
    "panel.background": "#070B14",
    "panel.border": "#1E293B",
    "panelTitle.activeBorder": "#38BDF8",
    "panelTitle.activeForeground": "#F8FAFC",
    "panelTitle.inactiveForeground": "#94A3B8",
    "terminal.background": "#070B14",
    "terminal.foreground": "#F1F5F9",
    "statusBar.background": "#070B14",
    "statusBar.foreground": "#E2E8F0",
    "statusBar.border": "#1E293B",
    "statusBar.noFolderBackground": "#070B14",
    "button.background": "#0284C7",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#0369A1",
    "input.background": "#0F172A",
    "input.foreground": "#F8FAFC",
    "input.border": "#334155",
    "input.placeholderForeground": "#94A3B8",
    "titleBar.activeBackground": "#070B14",
    "titleBar.activeForeground": "#F1F5F9",
    "titleBar.border": "#1E293B"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#94A3B8", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and Storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#38BDF8", "fontStyle": "bold" }
    },
    {
      "name": "Control Flow",
      "scope": ["keyword.control", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "#FB923C", "fontStyle": "bold" }
    },
    {
      "name": "Functions and Methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "name": "Types, Classes and Interfaces",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#2DD4BF" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#4ADE80" }
    },
    {
      "name": "Numbers and Constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#F472B6" }
    },
    {
      "name": "Variables and Parameters",
      "scope": ["variable", "variable.parameter", "meta.definition.variable"],
      "settings": { "foreground": "#F1F5F9" }
    },
    {
      "name": "Object Properties and Attributes",
      "scope": ["variable.other.property", "entity.other.attribute-name", "support.type.property-name"],
      "settings": { "foreground": "#93C5FD" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#38BDF8" }
    },
    {
      "name": "Operators and Punctuation",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#CBD5E1" }
    }
  ]
}
